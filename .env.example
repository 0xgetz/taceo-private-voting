# ============================================================
# TACEO Private Voting dApp — Environment Variables
# Copy this file: cp .env.example .env
# ============================================================

# RPC Endpoints (get a free key at https://infura.io or https://alchemy.com)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Wallet — NEVER commit your real private key!
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed Contract Addresses (filled after deployment)
CONTRACT_ADDRESS=0x...
VERIFIER_ADDRESS=0x...

# TACEO MPC Configuration
TACEO_API_KEY=your_taceo_api_key_here
TACEO_PROOF_ENDPOINT=https://proof.taceo.io
PARTY0_ENDPOINT=https://party0.taceo.io:50000
PARTY1_ENDPOINT=https://party1.taceo.io:50001
PARTY2_ENDPOINT=https://party2.taceo.io:50002

# Etherscan (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
